{
  "expo": {
    "name": "NaCzas",
    "slug": "naczas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "naczas",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B7A3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.naczas.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "NaCzas",
      "shortName": "NaCzas",
      "description": "Plan badań profilaktycznych na czas — dla Ciebie i bliskich.",
      "themeColor": "#1B7A3E",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7A3E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0C1A12"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "NaCzas dodaje do Twojego kalendarza przypomnienia o badaniach.",
          "writeOnlyCalendarPermission": "NaCzas dodaje do Twojego kalendarza przypomnienia o badaniach. Nie odczytuje Twoich wydarzeń.",
          "writeOnlyAccess": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "pl.naczas.app"
    }
  }
}
