# Mobile (Expo) — EXPO_PUBLIC_* is inlined into the client bundle, never put secrets here
EXPO_PUBLIC_API_URL=http://localhost:8787
# "1" = bundled mock data, no API calls (apps/mobile/src/services/client.ts); anything else = real API
EXPO_PUBLIC_USE_MOCKS=1

# API (validated in apps/api/src/env.ts)
NODE_ENV=development
PORT=8787
# Comma-separated web origins; in development any http://localhost:* is allowed as well
CORS_ORIGINS=http://localhost:8081
# Warm cache from data/snapshot, then refresh from NFZ in the background
REFRESH_ON_START=true
RATE_LIMIT_PER_MIN=60
# true only behind a reverse proxy (Render/Railway) — trusts X-Forwarded-For for client IPs
TRUST_PROXY=false

# "Zadzwoń za mnie" demo (apps/api/.env) — leave empty for the scripted simulation.
# The agent dials ONLY DEMO_CALL_TO (a team member's phone, +48XXXXXXXXX), never a clinic.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
DEMO_CALL_TO=
# Optional: ElevenLabs voice id (default: Azure pl-PL-ZofiaNeural)
VAPI_VOICE_ID=
# Optional: public https URL of the API (e.g. ngrok) for the live transcript webhook
PUBLIC_URL=
VAPI_WEBHOOK_SECRET=
# Instead of VAPI_PHONE_NUMBER_ID (no purchased number needed): Twilio calls from your verified
# caller ID and bridges to Vapi over its free SIP URI. TWILIO_FROM must differ from DEMO_CALL_TO.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VAPI_SIP_URI=
# NFZ Terminy Leczenia API root + version (change together; v1.3: https://api.nfz.gov.pl/app-itl-api + 1.3)
NFZ_BASE_URL=https://apinfz.nfz.gov.pl/app-itl-api-pcus
NFZ_API_VERSION=1.4
